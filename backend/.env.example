# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env
APP_ENV=development
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Supabase (Dashboard > Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Hanya dipakai di backend. JANGAN pernah dikirim ke frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=report-photos

# Supabase (Project Settings > Database > Connection string)
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@HOST:5432/postgres

# Batas unggahan foto
MAX_UPLOAD_MB=5
